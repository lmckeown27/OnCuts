VITE_API_URL=http://localhost:3001/api/v1
VITE_API_ORIGIN=http://localhost:3001

# Stripe.js (Checkout / Elements). Must match backend STRIPE_SECRET_KEY mode (pk_test_ with sk_test_, pk_live_ with sk_live_).
# Production: VITE_STRIPE_PUBLISHABLE_KEY=pk_live_…
VITE_STRIPE_PUBLISHABLE_KEY=
# testnet | mainnet | auto (omit) — aligns Stripe publishable key + Sui RPC/USDC with backend APP_NETWORK_MODE
VITE_APP_NETWORK_MODE=auto

VITE_SUI_RPC_URL=https://fullnode.testnet.sui.io:443
VITE_SUI_PROVER_URL=
# Mysten public zkLogin prover (default: https://prover-v2.mystenlabs.com/v1)
# VITE_SUI_ZKLOGIN_PROVER_URL=

# Google OAuth Web client ID (GIS Sign-In ID token + zkLogin implicit flow).
# Authorized JavaScript origins must include the exact page origin (scheme + host + port), e.g.:
#   http://localhost:3000
#   https://oncuts.com
#   https://www.oncuts.com
# (Vite uses port 3000 — http://localhost:5173 will fail with origin_mismatch unless you also run on 5173.)
# Authorized redirect URIs (exact path, for zkLogin):
#   http://localhost:3000/web/zklogin/callback
#   http://localhost:3000/app/zklogin/callback
# Production example: https://oncuts.com/web/zklogin/callback (and /app/... if you use PWA routes)
# Backend must set GOOGLE_OAUTH_WEB_CLIENT_ID to this same client ID so ID-token `aud` verifies.
VITE_GOOGLE_OAUTH_CLIENT_ID=
# Optional: public site origin if it differs from window.location (default: current origin). No trailing slash.
# VITE_ZKLOGIN_REDIRECT_ORIGIN=https://oncuts.com
# Same USDC coin type as backend (testnet example — adjust per network)
VITE_SUI_USDC_COIN_TYPE=0xa1ec7fc00a6f40db9693ad1415d0c193ad3906494428cf252621037bd7117e29::usdc::USDC
# Optional explorer base for “View on explorer” (default derives from RPC)
# VITE_SUI_EXPLORER_BASE_URL=https://suiscan.xyz/testnet
