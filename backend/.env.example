# Single switch: testnet (Stripe test + Sui testnet defaults) vs mainnet (Stripe live + Sui mainnet defaults).
# Omit or auto = no defaults from this; set SUI_RPC_URL / SUI_USDC_COIN_TYPE / STRIPE_* explicitly.
# STRIPE_MODE=test|live overrides Stripe key choice; when STRIPE_MODE=auto, this maps testnet→test keys, mainnet→live.
APP_NETWORK_MODE=auto

# Stripe — see src/config/stripe.ts
#
# Production / live (Tivela Platforms):
#   STRIPE_SECRET_KEY          = sk_live_…   (Tivela platform secret)
#   STRIPE_WEBHOOK_SECRET      = whsec_…     (live webhook for this account)
#   VITE_STRIPE_PUBLISHABLE_KEY = pk_live_…  (web-app — same Stripe account)
# FRONTEND_URL / STRIPE_CONNECT_BUSINESS_URL / STRIPE_STATEMENT_DESCRIPTOR are optional (unchanged from before).
#
# Generic (single mode — use live values above in prod, or sk_test_/whsec_ test values in dev):
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: split test + live (aliases: STRIPE_LIVE_SECRET_KEY / STRIPE_TEST_SECRET_KEY, STRIPE_LIVE_WEBHOOK_SECRET / STRIPE_TEST_WEBHOOK_SECRET)
STRIPE_SECRET_KEY_LIVE=
STRIPE_SECRET_KEY_TEST=
STRIPE_LIVE_SECRET_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_LIVE=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_TEST_WEBHOOK_SECRET=
# auto | live | test — auto picks key from NODE_ENV + sk_* env vars; webhook API uses event.livemode
STRIPE_MODE=auto

# Bridge + Sui
BRIDGE_API_KEY=
BRIDGE_API_BASE_URL=https://api.bridge.example
SUI_RPC_URL=
# Mainnet native USDC type (omit to use default in src/config/blockchain.ts)
SUI_USDC_COIN_TYPE=0xdba34672e30cb065b1f93e3ad5531876580039906648354972135f29979d9744::usdc::USDC
# Treasury wallet (must match the key below / holds merged USDC)
SUI_TREASURY_ADDRESS=
# Revenue wallet for 20% platform leg (optional; defaults to SUI_TREASURY_ADDRESS)
SUI_PLATFORM_PAYOUT_ADDRESS=
# Primary treasury private key (suiprivkey or hex). Used for gas when GAS_SPONSOR_SECRET unset; also signs USDC if SUI_TREASURY_SIGNER_SECRET unset.
SUI_TREASURY_SECRET=
# Optional: separate key that signs treasury USDC only (else SUI_TREASURY_SECRET / gas sponsor chain).
SUI_TREASURY_SIGNER_SECRET=
# Optional: dedicated gas wallet when SUI_SPONSOR_API_URL is unset (else SUI_TREASURY_SECRET → SUI_TREASURY_SIGNER_SECRET).
GAS_SPONSOR_SECRET=
# Optional: HTTP gas station returns sponsorSignature for same tx bytes as treasury (e.g. Shinami)
SUI_SPONSOR_API_URL=
SUI_SPONSOR_API_KEY=
# true = checkout.session.completed enqueues BullMQ process-payout (merge+split relayer); needs REDIS_URL
SUI_DIY_RELAYER_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
SUI_PROVER_URL=
# Native zkLogin: deterministic salt SHA256(MASTER_SEED + Google `sub`). Legacy: SALT_SERVICE_SECRET if MASTER_SEED unset.
MASTER_SEED=
# SALT_SERVICE_SECRET=

# Google Sign-In ID token audiences (used by POST /api/v1/auth/google — Intera iOS, etc.)
# The ID token JWT `aud` must match one of these (see PM2 logs on 401: token_aud vs configured_audiences).
# iOS: usually `CLIENT_ID` in Intera `GoogleService-Info.plist` (native iOS OAuth client).
GOOGLE_OAUTH_IOS_CLIENT_ID=
# Web: must match web `VITE_GOOGLE_OAUTH_CLIENT_ID` for zkLogin; also if iOS uses `serverClientId`, `aud` may be this Web client — add it here or in GOOGLE_OAUTH_CLIENT_IDS.
GOOGLE_OAUTH_WEB_CLIENT_ID=
# Optional comma-separated extra OAuth client IDs (same Google Cloud project) if `aud` differs from iOS/Web alone.
# GOOGLE_OAUTH_CLIENT_IDS=
# Optional: if only this name is set in deploy env, it is accepted as an additional audience for auth/google.
# VITE_GOOGLE_OAUTH_CLIENT_ID=

# Sign in with Apple (POST /api/v1/auth/apple). JWT `aud` must match one of these.
# Consumer app bundle ID:
# APPLE_CLIENT_ID=Liam.Intera
# Provider (barber) app — separate bundle ID:
# APPLE_PROVIDER_CLIENT_ID=
# Optional comma-separated extras:
# APPLE_CLIENT_IDS=

# Intera SMS (Pinpoint / End User Messaging — SendNotifyTextMessage). Region us-west-1 is set in code.
# IAM: sms-voice:SendNotifyTextMessage on your notify-configuration ARN.
# Optional: override default notify id from src/services/intera/SmsProvider.ts
# INTERA_NOTIFY_CONFIGURATION_ID=notify-cb19ae925d014cdba7b540cca202f72d
# Notify SMS template id (SendNotifyTextMessage requires this). List: describe-notify-templates in us-west-1.
# Default in code matches AWS CODE_VERIFICATION examples: notify-code-verification-english-001
# INTERA_NOTIFY_TEMPLATE_ID=notify-code-verification-english-001
# Placeholder key for the 6-digit code in that template (AWS examples use "code").
# INTERA_NOTIFY_TEMPLATE_OTP_KEY=code
# Phone OTP (POST /api/v1/auth/request-otp, /verify-otp): requires Redis. TTL for stored code (seconds), default 600 (10 min).
# INTERA_OTP_TTL_SECONDS=600

# App URLs (Stripe Checkout redirects)
FRONTEND_URL=http://localhost:5173
WEB_APP_URL=http://localhost:5173
