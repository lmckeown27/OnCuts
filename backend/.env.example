# Stripe — see src/config/stripe.ts
# Generic (single dashboard):
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: split test + live (same webhook URL verifies with any listed secret)
STRIPE_SECRET_KEY_LIVE=
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_LIVE=
STRIPE_WEBHOOK_SECRET_TEST=
# auto | live | test — auto picks key from NODE_ENV + sk_* env vars; webhook API uses event.livemode
STRIPE_MODE=auto

# Path B — Bridge + Sui
BRIDGE_API_KEY=
BRIDGE_API_BASE_URL=https://api.bridge.example
SUI_RPC_URL=
# Mainnet native USDC type (omit to use default in src/config/blockchain.ts)
SUI_USDC_COIN_TYPE=0xdba34672e30cb065b1f93e3ad5531876580039906648354972135f29979d9744::usdc::USDC
# Treasury wallet (must match SUI_TREASURY_SIGNER_SECRET / holds merged USDC)
SUI_TREASURY_ADDRESS=
# Revenue wallet for 20% platform leg (optional; defaults to SUI_TREASURY_ADDRESS)
SUI_PLATFORM_PAYOUT_ADDRESS=
# Optional: signs treasury USDC spend; defaults to GAS_SPONSOR_SECRET
SUI_TREASURY_SIGNER_SECRET=
# Local gas sponsor (second signature) when SUI_SPONSOR_API_URL is unset
GAS_SPONSOR_SECRET=
# Optional: HTTP gas station returns sponsorSignature for same tx bytes as treasury (e.g. Shinami)
SUI_SPONSOR_API_URL=
SUI_SPONSOR_API_KEY=
# true = checkout.session.completed enqueues BullMQ process-payout (merge+split relayer); needs REDIS_URL
SUI_DIY_RELAYER_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
SUI_PROVER_URL=
SALT_SERVICE_SECRET=

# Enoki (gas sponsorship + zkLogin server APIs) — https://docs.enoki.mystenlabs.com
# Server key from Enoki Portal (never expose to the browser). Also accepted: ENOKI_API_KEY.
ENOKI_SECRET_KEY=
# mainnet | testnet | devnet — should match SUI_RPC_URL
ENOKI_NETWORK=testnet
# Optional comma-separated allowlist: pkg::module::function
# ENOKI_ALLOWED_MOVE_CALL_TARGETS=0x2::coin::merge_coins,0x2::coin::split_coins,0x2::transfer::public_transfer

# App URLs (Stripe Checkout redirects)
FRONTEND_URL=http://localhost:5173
WEB_APP_URL=http://localhost:5173
