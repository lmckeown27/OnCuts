# CampusCuts Backend Environment Variables
# HYBRID ARCHITECTURE - Blockchain + PostgreSQL Cache

# Server Configuration
# Local: development. Production EC2: set NODE_ENV=production in PM2 (ecosystem `env` or `env_production`).
# Production on PM2: use backend/ecosystem.config.cjs — `pm2 start ecosystem.config.cjs --env production`
# so PM2 "node env" is production. A bare `pm2 start dist/index.js` leaves NODE_ENV=development unless you pass env.
NODE_ENV=development
PORT=3001

# ═══════════════════════════════════════════════════════════════════════
# DATABASE (Cache Layer - NOT Source of Truth!)
# ═══════════════════════════════════════════════════════════════════════
# PostgreSQL is used as a CACHE for fast queries
# Source of truth is ALWAYS the Aptos blockchain
# Data is synced from blockchain → PostgreSQL hourly
#
# macOS/Linux (Homebrew PostgreSQL): Use your username, no password needed
DATABASE_URL=postgresql://YOUR_USERNAME@localhost:5432/campuscuts
#
# Windows/Docker: Use postgres user with password
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campuscuts
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
# Production (Tivela Platforms): set FRONTEND_URL=https://tivelaplatforms.com on the server

# Redis Configuration (OPTIONAL - for caching blockchain queries)
# If not configured, app will work without caching (slower but functional)
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
# Long-lived refresh tokens for persistent mobile sign-in (~10 years unless overridden)
JWT_REFRESH_EXPIRES_IN=3650d
# Alias (optional): REFRESH_TOKEN_EXPIRES_IN=3650d

# ═══════════════════════════════════════════════════════════
# BLOCKCHAIN CONFIGURATION (REQUIRED - Replaces PostgreSQL!)
# ═══════════════════════════════════════════════════════════

# Aptos Blockchain - Primary data storage
APTOS_NETWORK=devnet
APTOS_NODE_URL=https://fullnode.devnet.aptoslabs.com/v1
APTOS_FAUCET_URL=https://faucet.devnet.aptoslabs.com

# Platform Account (signs transactions on behalf of users)
# Generate: aptos init --network devnet
# PETRA_PRIVATE_KEY is the primary environment variable
# (APTOS_PLATFORM_PRIVATE_KEY also supported for backwards compatibility)
PETRA_PRIVATE_KEY=0x...your_platform_private_key
APTOS_PLATFORM_ADDRESS=0x...your_platform_address

# Smart Contract Module Address (deploy contracts first)
APTOS_MODULE_ADDRESS=0x...your_deployed_module_address

# Custodial Wallet Encryption (CRITICAL SECURITY!)
# Use a strong random key (min 32 characters)
# NEVER commit the real key to git!
CUSTODIAL_ENCRYPTION_SECRET=change-this-to-a-very-long-random-string-min-32-characters

# ═══════════════════════════════════════════════════════════
# IPFS CONFIGURATION (REQUIRED - Decentralized File Storage)
# ═══════════════════════════════════════════════════════════

# Pinata API Keys (free tier: 1GB storage)
# Sign up at: https://app.pinata.cloud/
PINATA_API_KEY=your-pinata-api-key
PINATA_SECRET_API_KEY=your-pinata-secret-api-key
PINATA_JWT=your-pinata-jwt-token
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# IPFS Node URL (optional - uses Pinata by default)
IPFS_API_URL=https://api.pinata.cloud

# ═══════════════════════════════════════════════════════════
# STRIPE CONFIGURATION (REQUIRED - Fiat On/Off Ramp)
# ═══════════════════════════════════════════════════════════

# Stripe API Keys (get from: https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Same mode + Stripe account as STRIPE_SECRET_KEY. Required for native apps (returned on GET /api/v1/stripe/client-config and create-payment-intent). Optional alias: STRIPE_PUBLIC_KEY=pk_test_…
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Optional — card statement text (5–22 chars). Omit if unset; Stripe uses Dashboard business name.
#STRIPE_STATEMENT_DESCRIPTOR=TivelaPlatforms
# Optional — pre-filled on new Connect Express accounts only; code default is https://tivelaplatforms.com
#STRIPE_CONNECT_BUSINESS_URL=https://tivelaplatforms.com

# Platform Economics
PLATFORM_FEE_PERCENTAGE=5

# ═══════════════════════════════════════════════════════════
# USDC CONFIGURATION (REQUIRED - Stablecoin Payments)
# ═══════════════════════════════════════════════════════════

# Circle API (for USD ↔ USDC conversions)
# Sign up at: https://www.circle.com/en/developers
# Free tier: $100,000/month transaction volume
CIRCLE_API_KEY=your-circle-api-key
CIRCLE_API_URL=https://api-sandbox.circle.com
CIRCLE_WALLET_ID=your-circle-wallet-id

# Why USDC?
# - Stable 1:1 with USD (no volatility like APT)
# - Predictable payouts for barbers
# - Industry standard for blockchain payments
# - Instant settlement, no slippage

# ═══════════════════════════════════════════════════════════
# GAS WALLET CONFIGURATION (REQUIRED)
# ═══════════════════════════════════════════════════════════

# APT wallet that pays ALL blockchain gas fees
# Platform pays gas fees (not users)
# Keep topped up with ~100 APT ($1000) for smooth operations
# Can use PETRA_PRIVATE_KEY for both platform and gas wallet
GAS_WALLET_PRIVATE_KEY=0x...your_gas_wallet_private_key

# If not set, will use PETRA_PRIVATE_KEY or APTOS_PLATFORM_PRIVATE_KEY as gas wallet
# Recommended: Use separate wallet for gas vs USDC custody

# Gas Fee Economics:
# - Average: ~$0.0001 per transaction
# - 10,000 bookings ≈ $1 in gas fees
# - Platform absorbs all gas costs

# Email Configuration (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-app-email@gmail.com
SMTP_PASS=your-gmail-app-password

# Sign in with Apple (JWT exchange on POST /api/v1/auth/apple). JWT `aud` must match one of these bundle IDs / Services IDs.
# Consumer / student app (Intera):
#APPLE_CLIENT_ID=Liam.Intera
# Barber / Provider app (Intera - Provider) — separate bundle ID from consumer:
#APPLE_PROVIDER_CLIENT_ID=Liam.Intera.Provider
# Optional comma-separated extra bundle IDs or web Services IDs:
#APPLE_CLIENT_IDS=

# Optional: receive UGC report + user-block alerts (POST /api/messages/reports, POST /api/messages/blocks)
#MODERATION_ALERT_EMAIL=trust-safety@yourdomain.com

# Push Notifications - iOS (Apple Push Notification Service)
# Production Auth Key (Key ID from Apple Developer → Keys → your APNs key, or from filename AuthKey_ABC123XYZ.p8 → Key ID = ABC123XYZ)
APN_KEY_ID=your-apn-key-id
APN_TEAM_ID=your-apple-team-id
# Path relative to backend process.cwd() OR paste PEM with literal \n between lines (file path avoids character mismatch)
APN_PRIVATE_KEY=./path/to/AuthKey_XXXXXXXX.p8
# Dual-app apns-topic matrix (same APN_KEY_ID + APN_TEAM_ID + APN_PRIVATE_KEY for both).
# Used when mobile_devices.bundle_id is NULL; recipient role picks consumer vs provider topic.
CONSUMER_APN_BUNDLE_ID=Liam.Intera
PROVIDER_APN_BUNDLE_ID=Liam.Intera---Provider
# Legacy single-app fallback (CampusCuts web / older clients).
APN_BUNDLE_ID=com.campuscuts.ios
#
# Per-device override (recommended): POST /notifications/register-device body:
#   bundleId — exact APNs topic for that install (wins over env matrix above)
#   apnsEnvironment — sandbox (Xcode debug) or production (TestFlight/App Store)
# Server initializes BOTH APNs gateways; each row uses its own apns_environment + bundle_id.
#
# Optional second .p8 for sandbox gateway only (same team). If omitted, sandbox uses the same key as production (Apple-recommended).
# APN_SANDBOX_KEY_ID=698RL4U9X2
# APN_SANDBOX_PRIVATE_KEY=./keys/AuthKey_698RL4U9X2.p8

# Push Notifications - Android (Firebase Cloud Messaging)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project",...}

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_REQUESTS=750

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# External API Keys (optional for .edu validation)
WHOIS_API_KEY=your-whois-api-key

# Logging
LOG_LEVEL=info

